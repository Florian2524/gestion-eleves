# Exemple de configuration du backend (à exporter dans le shell ; Spring ne charge pas ce fichier directement)
DB_URL=jdbc:postgresql://localhost:5432/gestion_eleves
DB_USER=gestion_eleves
DB_PASSWORD=gestion_eleves
JWT_SECRET=remplacer-par-un-secret-base64-aleatoire-de-32-octets-minimum
JWT_EXPIRATION_SECONDS=3600
UPLOAD_DIRECTORY=uploads
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=choisir-un-mot-de-passe-long
BOOTSTRAP_ADMIN_NOM=Administration
BOOTSTRAP_ADMIN_PRENOM=Initiale
