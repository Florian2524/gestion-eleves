@startuml
title Saisie d'une note : parcours simplifié conforme au service
autonumber
actor Enseignant
boundary React
control "Spring Security / SecurityExpressions" as Security
control NoteController
control NoteService
entity NoteRepository
database PostgreSQL
Enseignant -> React : Saisir note
React -> Security : POST /notes + JWT + NoteRequest
alt Jeton absent / invalide
 Security --> React : 401
else Identité valide
 Security -> Security : Rôle et propriété de l'évaluation
 alt Ressource hors périmètre
  Security --> React : 403
 else Autorisé
  Security -> NoteController : Requête autorisée
  NoteController -> NoteController : Bean Validation
  NoteController -> NoteService : create(NoteRequest)
  NoteService -> NoteRepository : existsByScolarite_IdScolariteAndEvaluation_IdEvaluation(...)
  alt Doublon
   NoteService --> React : 409 via GlobalExceptionHandler
  else Nouvelle note
   NoteService -> PostgreSQL : Charger scolarité et évaluation via repositories
   NoteService -> NoteService : Vérifier classe et barème
   alt Données métier invalides
    NoteService --> React : 400 via GlobalExceptionHandler
   else Valides
    NoteService -> NoteRepository : save(note) dans transaction
    NoteRepository -> PostgreSQL : INSERT
    NoteService --> NoteController : NoteResponse
    NoteController --> React : 201 + NoteResponse
   end
  end
 end
end
@enduml
