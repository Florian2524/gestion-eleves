@startuml
title Diagramme de cas d'utilisation\nApplication de gestion des élèves

left to right direction

skinparam backgroundColor transparent
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 55
skinparam defaultTextAlignment center

skinparam ArrowColor #64748B
skinparam ActorBorderColor #334155
skinparam ActorFontColor #0F172A

skinparam usecase {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
}

skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #CBD5E1
    FontColor #0F172A
}

actor "Administrateur" as Admin
actor "Enseignant" as Enseignant

rectangle "Application de gestion des élèves" as Application {

    package "Accès sécurisé" {
        usecase "Se connecter\nà l'application" as UC_Connexion
    }

    package "Administration scolaire" {

        usecase "Gérer les élèves\n(consulter, ajouter, modifier,\nsupprimer et gérer la photo)" as UC_Eleves

        usecase "Gérer les inscriptions\n(inscrire, affecter à une classe,\nmodifier ou annuler)" as UC_Inscriptions

        usecase "Gérer les référentiels scolaires\n(classes, matières, périodes\net enseignements)" as UC_Referentiels

        usecase "Gérer les utilisateurs et les rôles\n(comptes, enseignants et\nresponsables légaux)" as UC_Utilisateurs
        usecase "Gérer les liens\nresponsable–élève" as UC_Responsabilites
    }

    package "Suivi pédagogique" {

        usecase "Consulter les élèves et les classes\nqui lui sont affectés" as UC_ClassesEleves

        usecase "Gérer les évaluations\n(créer, modifier et supprimer)" as UC_Evaluations

        usecase "Saisir les notes\n(ajouter, corriger, supprimer\net commenter)" as UC_Notes
        usecase "Consulter les notes\ndes élèves rattachés" as UC_ConsulterNotes
        usecase "Consulter les dossiers\ndes élèves rattachés" as UC_ConsulterEleves
    }

    package "Bulletins" {

        usecase "Consulter un bulletin\npar élève et par période" as UC_Bulletins

        usecase "Télécharger le bulletin\nau format PDF" as UC_Pdf
    }
}

actor "Responsable légal" as Responsable

' Accès commun
Admin --> UC_Connexion
Enseignant --> UC_Connexion
UC_Connexion <-- Responsable

' Fonctionnalités de l'administrateur
Admin --> UC_Eleves
Admin --> UC_Inscriptions
Admin --> UC_Referentiels
Admin --> UC_Utilisateurs
Admin --> UC_Responsabilites
Admin --> UC_Bulletins

' Fonctionnalités de l'enseignant
Enseignant --> UC_ClassesEleves
Enseignant --> UC_Evaluations
Enseignant --> UC_Notes
Enseignant --> UC_Bulletins

' Fonctionnalités du responsable légal
UC_Bulletins <-- Responsable
UC_ConsulterNotes <-- Responsable
UC_ConsulterEleves <-- Responsable

' L'export est une fonctionnalité facultative
' proposée pendant la consultation
UC_Pdf ..> UC_Bulletins : <<extend>>

note bottom of UC_Notes
L'enseignant agit uniquement dans le périmètre
des classes et enseignements qui lui sont attribués.
end note

note bottom of UC_Bulletins
Le responsable légal consulte uniquement les bulletins
des élèves auxquels il est associé.
end note
@enduml
